{
    "name": "wilycode/translation-database",
    "description": "Lazy database-backed PHP translation provider with pluralization, language fallback, and optional PSR-16 caching.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "psr/simple-cache": "^3.0",
        "wilycode/database-driver": "^0.1",
        "wilycode/translation": "^0.1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "wilycode/translation-languages": "^0.2"
    },
    "autoload": {
        "psr-4": {
            "WilyCode\\TranslationDatabase\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WilyCode\\TranslationDatabase\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "archive": {
        "exclude": [
            "/tests",
            "/examples",
            "/docs",
            "/benchmark",
            "/benchmarks",
            "/tools",
            "/phpunit.xml",
            "/phpunit.xml.dist",
            "/AGENTS.md",
            "/CHANGELOG.md",
            "/CONTRIBUTING.md",
            "/CODE_OF_CONDUCT.md",
            "/SECURITY.md",
            "/composer.lock",
            "/.github",
            "/.gitignore",
            "/.gitattributes",
            "/.editorconfig",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon",
            "/phpstan.neon.dist",
            "/phpstan.*.neon",
            "/phpstan.*.neon.dist",
            "/pint.json",
            "/rector.php",
            "/psalm.xml",
            "/psalm.xml.dist",
            "/infection.json",
            "/infection.json.dist"
        ]
    },
    "authors": [
        {
            "name": "Simon Piter"
        }
    ],
    "suggest": {
        "wilycode/translation-languages": "Ready-made language pluralization rules; optional if you supply your own LanguageInterface.",
        "wilycode/database-driver-pdo": "PDO driver implementation for database access."
    },
    "homepage": "https://github.com/wilycode/translation-database",
    "support": {
        "issues": "https://github.com/wilycode/translation-database/issues",
        "source": "https://github.com/wilycode/translation-database"
    },
    "keywords": [
        "translation",
        "localization",
        "i18n",
        "database",
        "mysql",
        "pluralization",
        "fallback",
        "cache",
        "psr-16",
        "wilycode"
    ],
    "scripts": {
        "test": "phpunit -c phpunit.xml.dist"
    }
}
